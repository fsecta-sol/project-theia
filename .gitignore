# Project Theia — ignore secrets, caches, build artifacts

# Secrets (NEVER commit)
.secret
.env
*.env

# SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# Node / build artifacts
node_modules/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hermes / Theia runtime
.cache/
cache/
*.bak
.commandcode

# Session files
last_session.txt
*.json

# BUT track the cron definitions (source of truth for scheduled jobs)
!cron/theia-jobs.json